# The Compte Kete (sign-in and admin API).
KETE_ACCOUNT_URL="http://localhost:3100"
# The Cockpit's own address.
COCKPIT_URL="http://127.0.0.1:3300"
# The Cockpit's registration at the Compte Kete (pnpm --filter @kete/account clients create …).
COCKPIT_CLIENT_ID=""
COCKPIT_CLIENT_SECRET=""
# At least 32 random characters, the Cockpit's only.
COCKPIT_SESSION_SECRET=""
# Kete's organization in the Compte Kete.
KETE_OPERATORS_ORGANIZATION_ID=""
# The Cockpit's database (Neon project kete-cockpit), application role without BYPASSRLS.
COCKPIT_DATABASE_URL="postgresql://cockpit_app:...@host/cockpit?sslmode=require"
# Owner role, migrations only (pnpm db:migrate).
COCKPIT_OWNER_URL="postgresql://cockpit_owner:...@host/cockpit?sslmode=require"
# 32 random bytes, base64: encrypts the apps' event-signing secrets. Losing it means new keys.
COCKPIT_ENCRYPTION_KEY=""
# Seconds between health readings of every app (0: off).
COCKPIT_PROBE_INTERVAL_SECONDS="300"
