{
  "name": "@kete/cockpit",
  "private": true,
  "type": "module",
  "description": "Kete Cockpit: where Kete operators run the Kete apps — the offers catalog first, then the app registry, events and briefs.",
  "scripts": {
    "dev": "vite dev --port 3300",
    "build": "vite build",
    "start": "srvx serve --entry dist/server/server.js --static dist/client --prod --host 0.0.0.0 --port 3000",
    "typecheck": "vite build && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@kete/auth": "npm:@kete-africa/auth@^0.1.0",
    "@kete/design": "npm:@kete-africa/design@^0.2.0",
    "@kete/sdk": "npm:@kete-africa/sdk@^0.2.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "0.11.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
