{
  "name": "@kete/cockpit",
  "private": true,
  "type": "module",
  "description": "Kete Cockpit: where Kete operators run the Kete apps — the offers catalog first, then the app registry, events and briefs.",
  "scripts": {
    "dev": "vite dev --port 3300",
    "build": "vite build",
    "start": "srvx serve --entry dist/server/server.js --static dist/client --prod --host 0.0.0.0 --port 3000",
    "test:e2e": "playwright test",
    "typecheck": "vite build && tsc --noEmit"
  },
  "dependencies": {
    "@kete/auth": "workspace:*",
    "@kete/design": "workspace:*",
    "@kete/sdk": "workspace:*",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "0.11.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
}
